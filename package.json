{
  "name": "afritecx-badboy-pos",
  "productName": "Afritecx Badboy POS",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:win": "npm run build && electron-builder --win nsis portable",
    "db:seed": "node scripts/seed-indexeddb.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  },
  "description": "Afritecx Badboy \u2014 South African Accounting & Point-of-Sale desktop application",
  "author": {
    "name": "Afritecx",
    "email": "support@afritecx.co.za"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "za.co.afritecx.badboypos",
    "productName": "Afritecx Badboy POS",
    "copyright": "Copyright \u00a9 2026 Afritecx",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AfritecxBadboyPOS-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Afritecx Badboy POS",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "AfritecxBadboyPOS-Portable-${version}-${arch}.${ext}"
    }
  }
}
