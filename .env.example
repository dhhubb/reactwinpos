# ─────────────────────────────────────────────────────────────────────────────
# Afritecx Badboy POS — environment template
#
# Copy this file to `.env` (or `.env.local`) and fill in the fields you need.
# The desktop app runs entirely on local IndexedDB, so every value below is
# OPTIONAL. Fill in the relational block only when attaching a server database.
#
# Build with:  npm run build          (reads .env)
# Windows:     npm run desktop:win    (produces the installer + portable .exe)
# ─────────────────────────────────────────────────────────────────────────────

# ── Relational database (optional) ───────────────────────────────────────────
# engine: postgres | mysql | sqlite | mssql
VITE_DB_ENGINE=postgres

# Hostname or IP of the database server.
VITE_DB_HOST=localhost

# Port: 5432 = PostgreSQL, 3306 = MySQL/MariaDB, 1433 = SQL Server.
VITE_DB_PORT=5432

# Database name (catalog).
VITE_DB_NAME=afritecx_pos

# Schema/namespace. PostgreSQL default is `public`; SQL Server often `dbo`.
VITE_DB_SCHEMA=public

# Credentials. Replace BOTH before enabling a remote connection.
VITE_DB_USER=CHANGE_ME
VITE_DB_PASSWORD=CHANGE_ME

# ── TLS ──────────────────────────────────────────────────────────────────────
# VITE_DB_SSL: true | false
VITE_DB_SSL=false

# sslmode: disable | prefer | require | verify-full
# Use `require` for most hosted providers; `verify-full` when a CA path is set.
VITE_DB_SSL_MODE=prefer

# Absolute path to the CA bundle, required when VITE_DB_SSL_MODE=verify-full.
VITE_DB_SSL_CA_PATH=

# ── Connection pool ──────────────────────────────────────────────────────────
VITE_DB_POOL_MIN=2
VITE_DB_POOL_MAX=10
VITE_DB_CONNECT_TIMEOUT_MS=10000
VITE_DB_IDLE_TIMEOUT_MS=30000

# ── Local IndexedDB ──────────────────────────────────────────────────────────
# Rename only if you need several independent tills on one Windows profile.
VITE_IDB_NAME=afritecx_badboy_pos
VITE_IDB_VERSION=1
